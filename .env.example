# Copiá este archivo como .env y completá los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha el servidor (ej: 8080)
PORT=

# URL de conexión a MongoDB (ej: la de MongoDB Atlas o mongodb://localhost:27017/shipnow)
MONGODB_URI=

# Entorno de ejecución: development, production o test
NODE_ENV=
