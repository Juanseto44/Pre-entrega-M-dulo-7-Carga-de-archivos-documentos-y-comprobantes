# Copiá este archivo como .env.test para correr los tests (npm test).
# El archivo .env.test NO se sube al repositorio (está en .gitignore).

# Puerto: los tests no abren ningún puerto, pero la validación de config lo exige
PORT=8081

# Base de datos EXCLUSIVA para tests. Es DISTINTA de la de desarrollo y se vacía en cada corrida.
# El nombre de la base tiene que contener la palabra "test" (ej: shipnow_test),
# si no, los tests se niegan a correr para no borrar datos reales.
MONGODB_URI=mongodb://localhost:27017/shipnow_test

# Siempre "test" (npm test ya lo configura solo)
NODE_ENV=test
